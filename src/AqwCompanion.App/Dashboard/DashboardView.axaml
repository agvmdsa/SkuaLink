<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:AqwCompanion.App.Shell"
             xmlns:ch="using:AqwCompanion.App.Characters"
             xmlns:hf="using:AqwCompanion.App.HardFarms"
             xmlns:q="using:AqwCompanion.App.Queue"
             x:Class="AqwCompanion.App.Dashboard.DashboardView"
             x:DataType="shell:MainViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource AqwTextMuted}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AqwSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AqwBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.cardHeader">
      <Setter Property="Background" Value="{DynamicResource AqwHeader}" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource AqwTextBright}" />
    </Style>
    <Style Selector="ProgressBar.rank">
      <Setter Property="Height" Value="5" />
      <Setter Property="MinHeight" Value="5" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Foreground" Value="{DynamicResource AqwBorder}" />
      <Setter Property="Background" Value="{DynamicResource AqwSurfaceRaised}" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="FigureTemplate" x:DataType="ch:ProfileFigure">
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,24,0">
        <TextBlock Text="{Binding Label}" Classes="muted" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Value}" FontWeight="SemiBold" Foreground="{DynamicResource AqwTextBright}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>

    <!-- A faction still to earn shows its bar; one at the highest rank is a quiet single line. -->
    <DataTemplate x:Key="FactionTemplate" x:DataType="ch:GameFactionRow">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="0,5">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock x:Name="DashboardFactionName" Text="{Binding Name}" FontWeight="SemiBold"
                     Foreground="{DynamicResource AqwTextBright}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="DashboardFactionRank" Text="{Binding Rank}" Classes="muted" />
        </StackPanel>
        <TextBlock x:Name="DashboardFactionToNext" Grid.Column="1" Classes="muted" Text="{Binding NextText}" />
        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Classes="rank" Margin="0,3,0,0" Value="{Binding Fraction}"
                     IsVisible="{Binding !IsMax}"
                     AutomationProperties.Name="{Binding Progress, StringFormat='Progress to the next rank: {0}'}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,*" Margin="12">
    <!-- The character: name, level and class on the band, then the numbers Skua reported, wrapping when they do not fit. -->
    <Border x:Name="DashboardProfileCard" Grid.ColumnSpan="2" Classes="card" Margin="0,0,0,12"
            IsVisible="{Binding Characters.HasCharacters}">
      <StackPanel>
        <Border Classes="cardHeader">
          <TextBlock x:Name="DashboardProfileHeadline" Text="{Binding Characters.ProfileHeadline}" Classes="cardTitle"
                     FontSize="18" AutomationProperties.Name="{Binding Characters.ProfileHeadline}" />
        </Border>
        <ItemsControl x:Name="DashboardFigures" ItemsSource="{Binding Characters.ProfileFigures}" Margin="14,8,14,2"
                      ItemTemplate="{StaticResource FigureTemplate}" AutomationProperties.Name="Character numbers">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock x:Name="DashboardCapturedText" Text="{Binding Characters.UpdatedText}" Classes="muted" FontSize="12"
                   Margin="14,0,14,8" TextWrapping="Wrap" IsVisible="{Binding Characters.HasUpdatedText}"
                   AutomationProperties.Name="{Binding Characters.UpdatedText}" />
      </StackPanel>
    </Border>

    <Border x:Name="DashboardEmptyCard" Grid.ColumnSpan="2" Classes="card" Margin="0,0,0,12"
            IsVisible="{Binding !Characters.HasCharacters}">
      <TextBlock x:Name="DashboardEmptyState" Text="{x:Static ch:CharactersViewModel.EmptyText}" TextWrapping="Wrap"
                 Margin="14,12" />
    </Border>

    <Border x:Name="DashboardReputationCard" Grid.Row="1" Classes="card" Margin="0,0,6,0">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="cardHeader">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Reputation" Classes="cardTitle" />
            <TextBlock Grid.Column="1" Text="closest to the next rank first" Classes="muted" FontSize="12"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <Panel>
            <ItemsControl x:Name="DashboardFactionList" ItemsSource="{Binding Characters.Factions}" Margin="14,4"
                          ItemTemplate="{StaticResource FactionTemplate}" AutomationProperties.Name="Faction standings" />
            <TextBlock x:Name="DashboardFactionsEmpty" Text="Your factions appear here after the next login." Classes="muted"
                       Margin="14,10" TextWrapping="Wrap" IsVisible="{Binding !Characters.HasCharacters}" />
          </Panel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border x:Name="DashboardHardFarmsCard" Grid.Row="1" Grid.Column="1" Classes="card" Margin="6,0,0,0">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="cardHeader">
          <TextBlock Text="Hard Farms" Classes="cardTitle" />
        </Border>
        <hf:HardFarmsView x:Name="DashboardHardFarms" Grid.Row="1" DataContext="{Binding HardFarms}" />
      </Grid>
    </Border>

    <!-- The script queue of the selected character: state, progress, steps and the five controls, plus the editor. -->
    <Border x:Name="DashboardQueueCard" Grid.Row="2" Grid.ColumnSpan="2" Classes="card" Margin="0,12,0,0"
            IsVisible="{Binding Queue, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel DataContext="{Binding Queue}" x:DataType="q:QueueViewModel">
        <Border Classes="cardHeader">
          <TextBlock Text="{x:Static q:QueueViewModel.TitleText}" Classes="cardTitle" />
        </Border>
        <StackPanel Margin="14,8,14,10" Spacing="6">
          <TextBlock x:Name="QueueStateText" Text="{Binding StateText}" FontWeight="SemiBold" Foreground="{DynamicResource AqwTextBright}"
                     AutomationProperties.Name="{Binding StateText}" />
          <TextBlock x:Name="QueueProgressText" Text="{Binding ProgressText}" Classes="muted" IsVisible="{Binding HasProgress}"
                     AutomationProperties.Name="{Binding ProgressText}" />
          <TextBlock x:Name="QueueReasonText" Text="{Binding ReasonText}" TextWrapping="Wrap" IsVisible="{Binding HasReason}"
                     AutomationProperties.Name="{Binding ReasonText}" />
          <TextBlock x:Name="QueueErrorText" Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{DynamicResource AqwDangerText}"
                     IsVisible="{Binding HasError}" AutomationProperties.Name="{Binding ErrorText}" />
          <TextBlock x:Name="QueueEmptyText" Text="{Binding EmptyStateText}" TextWrapping="Wrap" Classes="muted"
                     IsVisible="{Binding HasEmptyState}" AutomationProperties.Name="{Binding EmptyStateText}" />
          <ScrollViewer x:Name="QueueStepsScroll" MaxHeight="140" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="QueueSteps" ItemsSource="{Binding Steps}" AutomationProperties.Name="{x:Static q:QueueViewModel.StepsAutomation}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="q:QueueStepRow">
                  <Grid ColumnDefinitions="18,*" Margin="0,2">
                    <TextBlock Text="{Binding Marker}" FontWeight="Bold" Foreground="{DynamicResource AqwTextBright}" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Text}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <WrapPanel Margin="0,4,0,0">
            <Button x:Name="QueueStartButton" Content="{x:Static q:QueueViewModel.StartText}" Command="{Binding StartCommand}" Margin="0,0,8,0"
                    AutomationProperties.Name="{x:Static q:QueueViewModel.StartText}" />
            <Button x:Name="QueuePauseButton" Content="{x:Static q:QueueViewModel.PauseText}" Command="{Binding PauseCommand}" Margin="0,0,8,0"
                    AutomationProperties.Name="{x:Static q:QueueViewModel.PauseText}" />
            <Button x:Name="QueueContinueButton" Content="{x:Static q:QueueViewModel.ContinueText}" Command="{Binding ContinueCommand}" Margin="0,0,8,0"
                    AutomationProperties.Name="{x:Static q:QueueViewModel.ContinueText}" />
            <Button x:Name="QueueSkipButton" Content="{x:Static q:QueueViewModel.SkipText}" Command="{Binding SkipCommand}" Margin="0,0,8,0"
                    AutomationProperties.Name="{x:Static q:QueueViewModel.SkipText}" />
            <Button x:Name="QueueStopButton" Content="{x:Static q:QueueViewModel.StopText}" Command="{Binding StopCommand}" Margin="0,0,8,0"
                    AutomationProperties.Name="{x:Static q:QueueViewModel.StopText}" />
            <Button x:Name="QueueEditButton" Content="{x:Static q:QueueViewModel.EditText}" Command="{Binding EditCommand}"
                    AutomationProperties.Name="{x:Static q:QueueViewModel.EditText}" />
          </WrapPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
